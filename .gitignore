# Node modules
node_modules/

# Build outputs
bin/
obj/
dist/
packages/

# Generated code — only exclude obj/bin build-time artifacts
obj/**/*.g.cs
bin/**/*.g.cs
*.g.js

# Sisyphus auto-generated docs
.sisyphus/

# .TKWF 开发中枢：{域}/ 生成物 gitignore；TKWF-Rules.md 与 xCodeGen/ 配置进 git
.TKWF/*/
!.TKWF/xCodeGen/

# Runtime
.DS_Store
*.swp
*.swo
*~
*.log

# IDE
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Secrets
*.p12
*.pem
*.key
secrets.json
appsettings.*.local.json

# Legacy refs（框架已通过环境变量引用）
refs/
# TKWF skills junction（框架侧共享，单源同步）——不跟踪 junction 目标
.agents/skills/

# Python
__pycache__/
*.pyc
