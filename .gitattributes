# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all text files
*.cs    text eol=lf
*.cshtml text eol=lf
*.md    text eol=lf working-tree-encoding=UTF-8
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ps1   text eol=lf
*.sh    text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.dll   binary
*.exe   binary
*.pdb   binary