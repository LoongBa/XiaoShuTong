<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XiaoShuTong.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- NuGet 模式（默认）：TKWF 框架包（版本由 Directory.Packages.props CPM 集中管理，禁止硬编码版本号） -->
  <ItemGroup Condition="'$(TkwfReferenceMode)' != 'Dll'">
    <PackageReference Include="TKWF.Domain.Testing.xUnit" />
  </ItemGroup>

  <!-- DLL 模式：TKWFRole=Client（注入 TKWF.Domain/FreeSql）+ TKWFTest=true（注入测试基架 DLL）
       由 TKWF.Domain.targets 按角色自动注入。参考 DMP-Lite.Merchant.Domain.Test。 -->
  <PropertyGroup Condition="'$(TkwfReferenceMode)' == 'Dll'">
    <TKWFRole>Client</TKWFRole>
    <TKWFTest>true</TKWFTest>
  </PropertyGroup>

  <!-- DLL 模式补充：MockDbEntityDAC（v4.10.8 默认内存 DAC，框架 targets 未自动注入 Mock 程序集——
       LlmGatewayTests 等需 MockDbEntityDAC.Clear() 测试隔离） -->
  <ItemGroup Condition="'$(TkwfReferenceMode)' == 'Dll'">
    <Reference Include="TKWF.Domain.Testing.Mock" HintPath="$(TKWFDeployPath)build\refs\TKWF.Domain.Testing.Mock.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Test.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本在 Directory.Packages.props 中集中管理 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <!-- Tier 1.5：SQLite :memory: 内存库（真实 VEntity 视图/聚合/投影语义测试） -->
    <PackageReference Include="FreeSql.Provider.Sqlite" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 消费者项目引用：双模式共用 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\XiaoShuTong.Domain\XiaoShuTong.Domain.csproj" />
  </ItemGroup>

</Project>