<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    模板参考: DMP-Lite\DMP-Lite.Merchant.WebApi\DMP-Lite.Merchant.WebApi.csproj
    更新时请与该参考项目对齐。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XiaoShuTong.WebApi</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FastEndpoint\**" />
    <Content Remove="FastEndpoint\**" />
    <EmbeddedResource Remove="FastEndpoint\**" />
    <None Remove="FastEndpoint\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="$(IntermediateOutputPath)generated\**" />
    <Compile Remove="$(IntermediateOutputPath)generated\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本在 Directory.Packages.props 中集中管理 -->
    <PackageReference Include="HotChocolate" />
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.Data" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <PropertyGroup>
    <TKWFRole>ApiService</TKWFRole>
  </PropertyGroup>

  <ItemGroup Condition="'$(TkwfReferenceMode)' != 'Dll'">
    <Analyzer Include="$(TKWFRoot)build\refs\TKWF.Domain.ApiService.SG.dll" />
    <Analyzer Include="$(TKWFRoot)build\refs\TKWF.CodeGeneration.Abstractions.dll" />
    <ProjectReference Include="$(TKWFRoot)_Domain.SG\ApiService.SG\TKWF.Domain.ApiService.SG.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="$(TKWFRoot)_Domain.Infrastructure\Web\TKWF.Domain.Web.csproj" />
    <ProjectReference Include="$(TKWFRoot)_Domain.ApiService\HotChocolate\TKWF.Domain.ApiService.HotChocolate.csproj" />
    <ProjectReference Include="$(TKWFRoot)_Domain.ApiService\MinimalApi\TKWF.Domain.ApiService.MinimalApi.csproj" />
    <ProjectReference Include="$(TKWFRoot)_Domain.SG\CodeGeneration.Abstractions\TKWF.CodeGeneration.Abstractions.csproj" />
  </ItemGroup>

  <!-- 消费者项目引用：双模式共用 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\XiaoShuTong.Domain\XiaoShuTong.Domain.csproj" />
  </ItemGroup>

</Project>