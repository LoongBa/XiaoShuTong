<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    模板参考: DMP-Lite\DMP-Lite.Merchant.WebApi\DMP-Lite.Merchant.WebApi.csproj
    更新时请与该参考项目对齐。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XiaoShuTong.WebApi</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FastEndpoint\**" />
    <Content Remove="FastEndpoint\**" />
    <EmbeddedResource Remove="FastEndpoint\**" />
    <None Remove="FastEndpoint\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="$(IntermediateOutputPath)generated\**" />
    <Compile Remove="$(IntermediateOutputPath)generated\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本在 Directory.Packages.props 中集中管理 -->
    <PackageReference Include="HotChocolate" />
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.Data" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <PropertyGroup>
    <TKWFRole>ApiService</TKWFRole>
  </PropertyGroup>

  <ItemGroup Condition="'$(TkwfReferenceMode)' != 'Dll'">
    <Analyzer Include="$(TKWFDeployPath)build\refs\TKWF.Domain.ApiService.SG.dll" />
    <Analyzer Include="$(TKWFDeployPath)build\refs\TKWF.CodeGeneration.Abstractions.dll" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\ApiService.SG\TKWF.Domain.ApiService.SG.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.Infrastructure\Web\TKWF.Domain.Web.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.ApiService\HotChocolate\TKWF.Domain.ApiService.HotChocolate.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.ApiService\MinimalApi\TKWF.Domain.ApiService.MinimalApi.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\CodeGeneration.Abstractions\TKWF.CodeGeneration.Abstractions.csproj" />
  </ItemGroup>

  <!-- 消费者项目引用：双模式共用 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\XiaoShuTong.Domain\XiaoShuTong.Domain.csproj" />
  </ItemGroup>

  <!--
    NU1510：TKWF.Domain.targets 为所有 Dll 模式项目统一注入 System.Threading.RateLimiting 直接引用
    （类库 Dll 引用不传递 NuGet 依赖所需）。但 Web SDK 项目（Microsoft.NET.Sdk.Web）的共享框架
    Microsoft.AspNetCore.App 已内置该程序集，直接引用与之重复 → NU1510。此处显式移除，
    编译期/运行期类型仍由共享框架提供（对齐框架注释"Web SDK 项目会通过框架隐式引用同一版本"）。
    注意：注入发生在 Directory.Build.targets（csproj 之后），故须在 NuGet 收集引用前移除。
  -->
  <Target Name="_RemoveRedundantRateLimiting" BeforeTargets="CollectPackageReferences;_LoadRestoreGraphEntryPoints">
    <ItemGroup>
      <PackageReference Remove="System.Threading.RateLimiting" />
    </ItemGroup>
  </Target>

</Project>