<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    模板参考: DMP-Lite\DMP-Lite.Merchant.AdminUI\DMP-Lite.Merchant.AdminUI.csproj
    更新时请与该参考项目对齐。
  -->

  <!-- TKWFRoot fallback（Directory.Build.props 未覆盖时使用） -->
  <PropertyGroup>
    <TKWFRoot Condition="'$(TKWF_FRAMEWORK_PATH)' != ''">$([MSBuild]::EnsureTrailingSlash('$(TKWF_FRAMEWORK_PATH)'))</TKWFRoot>
    <TKWFRoot Condition="'$(TKWFRoot)' == ''">$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)..\..\..\_TKWF\'))</TKWFRoot>
    <TkwfReferenceMode>Dll</TkwfReferenceMode>
  </PropertyGroup>
  <!-- TKWF.Domain.props 由 Directory.Build.props 统一导入，此处不重复 Import -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ScopedCssEnabled>true</ScopedCssEnabled>
    <RootNamespace>XiaoShuTong.Wasm</RootNamespace>
    <TKWFRole>ApiClient</TKWFRole>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除以物理文件形式残留的 SG 生成代码，避免与运行时 SG 重复编译 -->
    <Compile Remove="Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="TKW.Framework.Domain" />
    <Using Include="TKW.Framework.Domain.ApiClient" />
    <Using Include="TKW.Framework.Domain.ApiClient" />
    <!-- 版本在 Directory.Packages.props 中集中管理 -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup Condition="'$(TkwfReferenceMode)' != 'Dll'">
    <ProjectReference Include="$(TKWFRoot)_Domain.Infrastructure\Blazor\TKWF.Domain.Blazor.csproj" />
    <ProjectReference Include="$(TKWFRoot)_Domain.SG\ApiService.SG\TKWF.Domain.ApiService.SG.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="$(TKWFRoot)_Domain.Api\ApiClient\TKWF.Domain.ApiClient.csproj" />
    <ProjectReference Include="$(TKWFRoot)_Domain.Api\ApiClient.GraphQL\TKWF.Domain.ApiClient.GraphQL.csproj" />
    <ProjectReference Include="$(TKWFRoot)_Domain.SG\CodeGeneration.Core\TKWF.CodeGeneration.Core.csproj" />
    <Analyzer Include="$(TKWFRoot)build\refs\TKWF.Domain.ApiService.SG.dll" />
    <Analyzer Include="$(TKWFRoot)build\refs\TKWF.CodeGeneration.Abstractions.dll" />
  </ItemGroup>

  <!-- DLL 模式：硬编码路径（BlazorWebAssembly SDK 不导入 Directory.Build.props） -->
  <ItemGroup Condition="'$(TkwfReferenceMode)' == 'Dll'">
    <Reference Include="TKWF.Domain" HintPath="$(RefsDir)TKWF.Domain.dll" />
    <Reference Include="TKWF.Domain.Blazor.Wasm" HintPath="$(RefsDir)TKWF.Domain.Blazor.Wasm.dll" />
    <Reference Include="TKWF.Domain.Blazor.Abstractions" HintPath="$(RefsDir)TKWF.Domain.Blazor.Abstractions.dll" />
    <Reference Include="TKWF.Domain.ApiClient" HintPath="$(RefsDir)TKWF.Domain.ApiClient.dll" />
    <Reference Include="TKWF.Utility" HintPath="$(RefsDir)TKWF.Utility.dll" />
    <Reference Include="TKWF.Core" HintPath="$(RefsDir)TKWF.Core.dll" />
  </ItemGroup>

  <!-- 引用 Domain 项目中的 UserInfo 类型和 WebApi 元数据 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\XiaoShuTong.Domain\XiaoShuTong.Domain.csproj" />
    <ProjectReference Include="..\..\src\XiaoShuTong.WebApi\XiaoShuTong.WebApi.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <Compile Include="..\..\src\XiaoShuTong.WebApi\obj\$(Configuration)\net10.0\generated\TKWF.Domain.ApiService.SG\TKW.Framework.CodeGeneration.ApiServiceGenerator\ApiMetadata.g.cs"
             Link="Metadata\ApiMetadata.g.cs" Visible="false"
             Condition="Exists('..\..\src\XiaoShuTong.WebApi\obj\$(Configuration)\net10.0\generated\TKWF.Domain.ApiService.SG\TKW.Framework.CodeGeneration.ApiServiceGenerator\ApiMetadata.g.cs')" />
  </ItemGroup>

  <!-- 确保 WebApi 的 SG 生成文件（ApiMetadata.g.cs）在 Wasm 编译前就绪 -->
  <Target Name="_EnsureWebApiMetadata" BeforeTargets="CoreCompile"
          Inputs="..\..\src\XiaoShuTong.WebApi\XiaoShuTong.WebApi.csproj"
          Outputs="..\..\src\XiaoShuTong.WebApi\obj\$(Configuration)\net10.0\generated\TKWF.Domain.ApiService.SG\TKW.Framework.CodeGeneration.ApiServiceGenerator\ApiMetadata.g.cs">
    <MSBuild Projects="..\..\src\XiaoShuTong.WebApi\XiaoShuTong.WebApi.csproj"
             Targets="Build"
             Properties="TkwfReferenceMode=Dll"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
  </Target>

  <!-- 拷贝 CSS 隔离文件到输出 wwwroot -->
  <Target Name="CopyScopedCss" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css"
          DestinationFiles="$(OutDir)wwwroot\$(AssemblyName).styles.css"
          Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css')" />
  </Target>

</Project>