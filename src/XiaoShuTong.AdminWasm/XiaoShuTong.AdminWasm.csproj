<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    模板参考: DMP-Lite\DMP-Lite.Merchant.AdminUI\DMP-Lite.Merchant.AdminUI.csproj
    更新时请与该参考项目对齐。
  -->

  <!-- 路径回退（Directory.Build.props 未覆盖时使用）：
       TKWFSourceRoot = 源码根（相对路径）；TKWFDeployPath = 部署根（环境变量规范化） -->
  <PropertyGroup>
    <TKWFSourceRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)..\..\..\_TKWF\'))</TKWFSourceRoot>
    <TKWFDeployPath Condition="'$(TKWFDeployPath)' == ''">$([MSBuild]::EnsureTrailingSlash('$(TKWFDeployPath)'))</TKWFDeployPath>
    <TkwfReferenceMode>Dll</TkwfReferenceMode>
  </PropertyGroup>
  <!-- TKWF.Domain.props 由 Directory.Build.props 统一导入，此处不重复 Import -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ScopedCssEnabled>true</ScopedCssEnabled>
    <RootNamespace>XiaoShuTong.AdminWasm</RootNamespace>
    <TKWFRole>ApiClient</TKWFRole>
    <!-- 独立版本线：领域/WebH5/AdminWasm 各自独立 MinVer tag（前缀区分，项目前缀方案）。
         覆盖 Directory.Build.props 的全局 MinVerTagPrefix=v，AdminWasm 只识别 AdminWasm-V* tag。 -->
    <MinVerTagPrefix>AdminWasm-V</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除以物理文件形式残留的 SG 生成代码，避免与运行时 SG 重复编译 -->
    <Compile Remove="Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="TKW.Framework.Domain" />
    <Using Include="TKW.Framework.Domain.ApiClient" />
    <Using Include="TKW.Framework.Domain.ApiClient" />
    <!-- 版本在 Directory.Packages.props 中集中管理 -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="AntDesign.Extensions.Localization" />
    <PackageReference Include="AntDesign.ProLayout" />
  </ItemGroup>

  <ItemGroup Condition="'$(TkwfReferenceMode)' != 'Dll'">
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.Infrastructure\Blazor\TKWF.Domain.Blazor.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\ApiService.SG\TKWF.Domain.ApiService.SG.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.Api\ApiClient\TKWF.Domain.ApiClient.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.Api\ApiClient.GraphQL\TKWF.Domain.ApiClient.GraphQL.csproj" />
    <ProjectReference Include="$(TKWFSourceRoot)_Domain.SG\CodeGeneration.Core\TKWF.CodeGeneration.Core.csproj" />
    <Analyzer Include="$(TKWFDeployPath)build\refs\TKWF.Domain.ApiService.SG.dll" />
    <Analyzer Include="$(TKWFDeployPath)build\refs\TKWF.CodeGeneration.Abstractions.dll" />
  </ItemGroup>

  <!-- DLL 模式：核心框架引用由 TKWF.Domain.targets 按 TKWFRole=ApiClient 自动注入（路径 $(TKWFDeployPath)build\refs\），
       此处仅补充自动注入不包含的 Blazor WASM 宿主 DLL（ConfigWasmClient/UseWasmAuth 扩展所在）。
       框架引用路径统一使用 $(TKWFDeployPath)build\refs\（Agents_Use_TKWF.md §5），不使用本地 refs/。 -->
  <ItemGroup Condition="'$(TkwfReferenceMode)' == 'Dll'">
    <Reference Include="TKWF.Domain.Blazor.Wasm" HintPath="$(TKWFDeployPath)build\refs\TKWF.Domain.Blazor.Wasm.dll" />
    <Reference Include="TKWF.Domain.Blazor.Abstractions" HintPath="$(TKWFDeployPath)build\refs\TKWF.Domain.Blazor.Abstractions.dll" />
  </ItemGroup>

  <!-- 引用 Domain 项目中的 UserInfo 类型和 WebApi 元数据
       ADR32 决策 2/3（框架 v4.10.0）：SG2 元数据引用 .TKWF/{域}/ApiMetadata.g.cs 稳定路径，
       不再直接引用 obj/...generated/ 深层路径（TFM/配置切换/SG 改名断链根因）。
       {域} = $(TKWFDomain)（自包含定义，与 WebApi 侧 Directory.Build.props 同源同值）。 -->
  <PropertyGroup>
    <TKWFDomain>XiaoShuTong.WebApi</TKWFDomain>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XiaoShuTong.Domain\XiaoShuTong.Domain.csproj" />
    <ProjectReference Include="..\..\src\XiaoShuTong.WebApi\XiaoShuTong.WebApi.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <Compile Include="..\..\.TKWF\$(TKWFDomain)\ApiMetadata.g.cs"
             Link="Metadata\ApiMetadata.g.cs" Visible="false"
             Condition="Exists('..\..\.TKWF\$(TKWFDomain)\ApiMetadata.g.cs')" />
  </ItemGroup>

  <!-- 确保 WebApi 的 SG 生成文件（ApiMetadata.g.cs）在 Wasm 编译前就绪（v4.10.0 模式）
       ProjectReference(ReferenceOutputAssembly=false) 在并行构建时不保证 WebApi 先编译，
       故在 CoreCompile 前显式 MSBuild 构建 WebApi，生成 ApiMetadata.g.cs 供 SG3 客户端代理消费。
       Inputs 含 WebApi 全部源码（排除 obj/bin）：改任何 WebApi 源码（含 .cs）都触发重建。
       Outputs 指向 .TKWF/$(TKWFDomain)/ApiMetadata.g.cs（稳定路径）。 -->
  <ItemGroup>
    <_WebApiInputs Include="..\..\src\XiaoShuTong.WebApi\XiaoShuTong.WebApi.csproj;..\..\src\XiaoShuTong.WebApi\**\*.cs"
                   Exclude="..\..\src\XiaoShuTong.WebApi\obj\**;..\..\src\XiaoShuTong.WebApi\bin\**" />
  </ItemGroup>
  <Target Name="_EnsureWebApiMetadata" BeforeTargets="CoreCompile"
          Inputs="@(_WebApiInputs)"
          Outputs="..\..\.TKWF\$(TKWFDomain)\ApiMetadata.g.cs">
    <!-- TKWFDomain 空值兜底（Oracle Q4.3）：占位符替换失败时显式报错而非静默路径错位 -->
    <Error Condition="'$(TKWFDomain)' == ''"
           Text="[TKWF] TKWFDomain 未定义——请配置域标识（ADR32 决策 2），例如 &lt;TKWFDomain&gt;XiaoShuTong.WebApi&lt;/TKWFDomain&gt;" />
    <MSBuild Projects="..\..\src\XiaoShuTong.WebApi\XiaoShuTong.WebApi.csproj"
             Targets="Build"
             Properties="TkwfReferenceMode=Dll"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
  </Target>

  <!-- 拷贝 CSS 隔离文件到输出 wwwroot -->
  <Target Name="CopyScopedCss" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css"
          DestinationFiles="$(OutDir)wwwroot\$(AssemblyName).styles.css"
          Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css')" />
  </Target>

</Project>