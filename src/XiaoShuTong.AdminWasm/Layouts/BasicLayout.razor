@namespace XiaoShuTong.AdminWasm.Layouts
@inherits LayoutComponentBase
@attribute [Authorize]

<AntDesign.ProLayout.BasicLayout Logo="@("/assets/logo.svg")"
    MenuData="_MenuData"
    MenuAccordion
    @bind-Collapsed="_Collapsed">
    <HeaderContentRender>
        <Space Size="@("24")">
            <SpaceItem>
                <Icon Class="action" Type="@(_Collapsed?"menu-unfold":"menu-fold")" OnClick="Toggle" />
            </SpaceItem>
            <SpaceItem>
                <Icon Class="action" Type="reload" Theme="@IconThemeType.Outline" OnClick="Reload" />
            </SpaceItem>
        </Space>
    </HeaderContentRender>
    <RightContentRender>
        <XiaoShuTong.AdminWasm.Components.RightContent />
    </RightContentRender>
    <ChildContent>
        @Body
    </ChildContent>
    <FooterRender>
        <FooterView Copyright="2025 小书童" Links="Links"></FooterView>
    </FooterRender>
</AntDesign.ProLayout.BasicLayout>

<SettingDrawer />

@code{
    bool _Collapsed;

    public LinkItem[] Links =
    {
    };

    void Toggle()
    {
        _Collapsed = !_Collapsed;
    }

}
