            else if (col.Properties != null && col.Properties.TryGetValue("Position", out var positionVal)) pos = positionVal;
            return pos is int i ? i : 999;
        }).ToList();

    // 辅助：处理多行 Summary 格式安全
    string CleanSummary(string? sum) => string.IsNullOrWhiteSpace(sum) ? "" 
        : sum.Replace("\r", "").Replace("\n", " ").Trim();

    // Auto-derive usings from property types（使用共享的 NamespaceHelper）
