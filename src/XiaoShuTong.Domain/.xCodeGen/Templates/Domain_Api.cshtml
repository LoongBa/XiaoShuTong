@{
    var hash = Model.Configuration.CustomProperties.ContainsKey("MetadataHash")
        ? Model.Configuration.CustomProperties["MetadataHash"] : "N/A";

    // 剥离 global:: 前缀，缩短类型名
    string StripGlobal(string? typeName) =>
        string.IsNullOrEmpty(typeName) ? "object" : typeName.Replace("global::", "");

    // 取参数类型名：优先 TypeFullName（含完整泛型签名），回退 TypeName
    string ParamTypeName(ParameterMetadata p) =>
        StripGlobal(!string.IsNullOrEmpty(p.TypeFullName) ? p.TypeFullName : p.TypeName);

    var contracts = Model.Controllers
        .Select(c => new { Name = c.InterfaceName ?? c.Interface?.ClassName ?? "I" + c.ClassName, Methods = (c.Interface?.Methods != null && c.Interface.Methods.Count > 0) ? c.Interface.Methods : c.Methods, Type = "Controller", Summary = c.Interface?.Summary ?? c.Summary, SubDomain = c.SubDomain })
        .OrderBy(x => x.SubDomain).ThenBy(x => x.Name)
        .ToList();
    var subDomainGroups = contracts.GroupBy(c => string.IsNullOrEmpty(c.SubDomain) ? "默认" : c.SubDomain)
        .OrderBy(g => g.Key);
}
