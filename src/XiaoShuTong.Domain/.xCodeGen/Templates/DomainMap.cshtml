    // V4.9.28: 截断改为软截断（不切词）
    static string SanitizeSummary(string? summary)
    {
        if (string.IsNullOrWhiteSpace(summary)) return "-";
        // Strip HTML tags manually
        var cleaned = summary;
        int start;
        while ((start = cleaned.IndexOf('<')) >= 0)
        {
            var end = cleaned.IndexOf('>', start);
            if (end < 0) break;
            cleaned = cleaned[..start] + " " + cleaned[(end + 1)..];
        }
        // Compress whitespace
        var result = new System.Text.StringBuilder();
        bool inSpace = false;
        foreach (var c in cleaned)
        {
            if (char.IsWhiteSpace(c))
            {
                if (!inSpace) { result.Append(' '); inSpace = true; }
            }
            else { result.Append(c); inSpace = false; }
        }
        cleaned = result.ToString().Trim();
        cleaned = cleaned.Replace("|", "\\|");
        // 软截断：截断到最后一个空格前，避免切词（如 "ByXxx(va..."）
        if (cleaned.Length > 60)
        {
            var truncated = cleaned[..57];
            var lastSpace = truncated.LastIndexOf(' ');
            if (lastSpace > 30) // 仅在有合理断词点时截断；否则硬截断
                cleaned = truncated[..lastSpace] + "...";
            else
                cleaned = truncated + "...";
        }
