@* V4.9.106 (P2/ADR55): ViewSql 方言翻译参考模板——从 VEntity 声明解析 SQL 结构，
   生成方言变体翻译清单，供 Agent/开发者编写 ViewSqlSqlServer/MySql/SQLite/Oracle 变体时参考。
   定位：节约 Agent 思考（方案 §3.5 翻译层"尽力而为"），非自动翻译。 *@
@using System.Linq
@using TKW.Framework.CodeGeneration
@model ClassMetadata
@{
    var metaHash = Model.GenerateCodeSettings.ContainsKey("MetadataHash") ? Model.GenerateCodeSettings["MetadataHash"]?.ToString() : "N/A";
    var timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");

    // 仅 View 类型产出——非 View 输出跳过说明（RazorLight 不支持代码块内 return 阻止后续输出）
    if (Model.Type != MetaType.View)
    {
        WriteLiteral($"<!-- 跳过：{Model.ClassName} (Type={Model.Type}) 非 View 类型，ViewSqlDraft 仅对 VEntity 生效（V4.9.106/ADR55） -->\n");
    }
    else
    {
        // 方言变体状态
        var hasVariants = Model.GenerateCodeSettings.TryGetValue("ViewSqlByProvider", out var variantsObj)
            && variantsObj is Dictionary<string, string> variantsDict && variantsDict.Count > 0;

        // 基表清单
        var baseTables = new List<string>();
        if (!string.IsNullOrEmpty(Model.ViewSql))
        {
            foreach (var t in ViewSqlParser.ExtractFromTables(Model.ViewSql))
                if (!baseTables.Contains(t, StringComparer.OrdinalIgnoreCase)) baseTables.Add(t);
        }

        // 列映射
        var sqlColumns = new HashSet<string>(string.IsNullOrEmpty(Model.ViewSql)
            ? Array.Empty<string>() : ViewSqlParser.ParseColumns(Model.ViewSql), StringComparer.OrdinalIgnoreCase);

        // 表名（[Table(Name=...)] 特性）
        var tableAttr = Model.Attributes?.FirstOrDefault(a => a.TypeFullName != null && a.TypeFullName.EndsWith("TableAttribute", StringComparison.Ordinal));
        string tableName = "vw_" + Model.ClassName;
        if (tableAttr != null)
        {
            if (tableAttr.Properties != null && tableAttr.Properties.TryGetValue("Name", out var nameVal) && nameVal != null)
                tableName = nameVal.ToString()!;
            else if (tableAttr.ConstructorArguments != null && tableAttr.ConstructorArguments.Count > 0
                && tableAttr.ConstructorArguments.FirstOrDefault() is { } ctorName)
                tableName = ctorName.ToString()!;
        }

        var sb = new System.Text.StringBuilder();
        sb.Append("[//]: # ( <auto-generated> [xCodeGen.Hash: ").Append(metaHash).AppendLine("] </auto-generated> )");
        sb.AppendLine();
        sb.AppendLine("# ViewSql 方言翻译参考 — " + Model.ClassName);
        sb.AppendLine();
        sb.AppendLine("> **自动生成** — 解析 `[DomainGenerateCode(ViewSql = ...)]` 声明，供编写 ADR53 方言变体时参考。");
        sb.AppendLine("> 生成时间：" + timestamp);
        sb.AppendLine(">");
        sb.AppendLine("> 🔒 **本文件是参考清单，不是可执行 SQL**。方言翻译由 Agent/开发者完成（ADR53 策略），框架不集成翻译库。");
        sb.AppendLine("> 翻译结果写入 `ViewSqlSqlServer` / `ViewSqlMySql` / `ViewSqlSQLite` / `ViewSqlOracle` 变体属性。");
        sb.AppendLine();
        sb.AppendLine("---");
        sb.AppendLine();
        sb.AppendLine("## 一、基本信息");
        sb.AppendLine();
        sb.AppendLine("| 项 | 值 |");
        sb.AppendLine("|----|----|");
        sb.AppendLine("| VEntity | `" + Model.ClassName + "` |");
        sb.AppendLine("| 表名（`[Table(Name=...)]`） | `" + tableName + "` |");
        sb.AppendLine("| 命名空间 | `" + Model.Namespace + "` |");
        sb.AppendLine("| 方言变体状态 | " + (hasVariants ? "已提供变体（见 §四）" : "⚠️ 未提供变体——切库需手工翻译（ADR53）") + " |");
        sb.AppendLine();
        sb.AppendLine("## 二、基表清单（ViewSql FROM/JOIN）");
        sb.AppendLine();
        if (baseTables.Count == 0)
        {
            sb.AppendLine("> ⚠️ 未能从 ViewSql 提取基表（ViewSql 为空或解析受限——如 CTE/子查询）。请人工核对 ViewSql。");
        }
        else
        {
            sb.AppendLine("| # | 基表 |");
            sb.AppendLine("|---|------|");
            for (var i = 0; i < baseTables.Count; i++)
                sb.AppendLine("| " + (i + 1) + " | `" + baseTables[i] + "` |");
        }
        sb.AppendLine();
        sb.AppendLine("## 三、列映射（C# 属性 ↔ SQL 列别名 ↔ SQL 类型）");
        sb.AppendLine();
        sb.AppendLine("> SQL 列 = ViewSql SELECT 别名（VIEW001 双向校验保证与 C# 属性一致）；SQL 类型来自 `SqlTypeName`（P1/U3）。");
        sb.AppendLine();
        sb.AppendLine("| C# 属性 | SQL 类型 | 在 ViewSql 投影中 |");
        sb.AppendLine("|---------|----------|:---:|");
        foreach (var p in Model.Properties.OrderBy(p => p.Name, StringComparer.Ordinal))
        {
            var inSql = sqlColumns.Contains(p.Name);
            var sqlType = string.IsNullOrEmpty(p.SqlTypeName) ? "-" : p.SqlTypeName;
            sb.AppendLine("| `" + p.Name + "` | `" + sqlType + "` | " + (inSql ? "✅" : "⚠️ 缺失（IsComputed 或校验应报 VIEW001）") + " |");
        }
        sb.AppendLine();
        sb.AppendLine("## 四、方言变体状态");
        sb.AppendLine();
        if (hasVariants && variantsObj is Dictionary<string, string> vDict)
        {
            sb.AppendLine("| Provider | 变体 |");
            sb.AppendLine("|----------|------|");
            foreach (var kv in vDict.OrderBy(k => k.Key, StringComparer.Ordinal))
                sb.AppendLine("| `" + kv.Key + "` | 已提供 |");
        }
        else
        {
            sb.AppendLine("> 无方言变体。翻译时注意 PG 特有语法（`FILTER`/`::` 类型转换/`CASCADE`/双引号标识符折叠）——见 VIEW003 诊断。");
        }
        sb.AppendLine();
        sb.AppendLine("## 五、原 ViewSql（PostgreSQL 默认）");
        sb.AppendLine();
        sb.AppendLine("```sql");
        sb.Append(Model.ViewSql ?? "");
        sb.AppendLine();
        sb.AppendLine("```");
        WriteLiteral(sb.ToString());
    }
}
