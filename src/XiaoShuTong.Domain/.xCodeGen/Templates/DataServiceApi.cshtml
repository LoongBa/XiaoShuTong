@using System.Linq
@using TKW.Framework.CodeGeneration
@using TKW.Framework.Domain.xCodeGen
@inherits xCodeGen.Core.Templates.TemplatePageBase<IProjectMetaContext>
@model IProjectMetaContext
@{
    // ─
    //  DataService API 文档 — V3.4+ Conditions 模式
    //  命名规则与 Conditions.cshtml 一致（共用 CodeGenPolicy.GetSearchGroups）
    // ─
    var entities = Model.Entities.Where(m => m.Type == MetaType.Entity || m.Type == MetaType.View)
        .OrderBy(m => m.SubDomain).ThenBy(m => m.ClassName).ToList();
    var subDomainGroups = entities.GroupBy(e => string.IsNullOrEmpty(e.SubDomain) ? "默认" : e.SubDomain)
        .OrderBy(g => g.Key);
    var hash = Model.Configuration.CustomProperties.ContainsKey("MetadataHash")
        ? Model.Configuration.CustomProperties["MetadataHash"] : "N/A";

    string LowerFirst(string s) => char.ToLowerInvariant(s[0]) + s[1..];

    // ── 条件方法参数描述 ──
    string GetConditionParams(string groupName, List<PropertyMetadata> props, bool isUnique)
    {
        var parts = new List<string>();
        foreach (var p in props)
        {
            var pLower = LowerFirst(p.Name);
            if (p.TypeName.Contains("string"))
                parts.Add($"string? {pLower} = null");
            else if (p.TypeName.Contains("DateTime"))
            {
                parts.Add($"DateTime? begin{p.Name} = null");
                parts.Add($"DateTime? end{p.Name} = null");
            }
            else
                parts.Add($"{p.TypeName}? {pLower} = null");
        }
        return string.Join(", ", parts);
    }

    // ── 条件方法名 ──
    string[] GetConditionMethodNames(string groupName, List<PropertyMetadata> props, bool isUnique)
    {
        var names = new List<string>();
        if (isUnique)
            names.Add($"By{groupName}");
        else
        {
            names.Add($"By{groupName}");
            // Like 方法：每个字符串属性
            foreach (var p in props.Where(p => p.TypeName.Contains("string")))
            {
                names.Add($"Like{p.Name}");
            }
            // LikeKeywords
            if (props.Any(p => p.TypeName.Contains("string")))
                names.Add($"Like{groupName}Keywords");
            // 跨属性模糊
            if (props.Count(p => p.TypeName.Contains("string")) >= 2)
                names.Add($"Like{groupName}");
            // DateTime 范围
            foreach (var p in props.Where(p => p.TypeName.Contains("DateTime")))
                names.Add($"By{p.Name}Range");
        }
        return names.ToArray();
    }

    string GetConditionDescription(string methodName, string groupName, List<PropertyMetadata> props)
    {
        if (methodName == $"By{groupName}")
            return "精确组合匹配（AND）";
        if (methodName.StartsWith("Like") && methodName.EndsWith("Keywords"))
            return "多值模糊（OR-链）";
        if (methodName.StartsWith("Like") && methodName != $"Like{groupName}")
            return "模糊搜索";
        if (methodName == $"Like{groupName}")
            return "跨属性模糊（OR）";
        if (methodName.StartsWith("By") && methodName.EndsWith("Range"))
            return "时间范围";
        return "条件谓词";
    }
}
